      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The versioned CDEvents type the record was mapped from."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CDEvents type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/delivery/ns#cloudEventId",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "CloudEvents id attribute; unique within its source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CloudEvent id"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/delivery/ns#cloudEventSource",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
