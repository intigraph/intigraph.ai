      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#OperationalRule",
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Directive"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#PathOmission",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One pruning ruling: a step a GoldenPath deliberately excludes, carrying the authority for the cut — the deterministic cone analysis, or a human Decision. Pruning is curation, never erasure."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Path omission"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#PathPromotion",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A promotion event on the blessing ladder: who promoted the path, when, to which level, citing which evidence. The level is a fact of this event at write time; a path's current fitness is a read-time judgment, never stored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Path promotion"
      }
    ]
  },
  {
