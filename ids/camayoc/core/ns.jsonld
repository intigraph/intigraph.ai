        "@id": "https://schema.org/TVSeries"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#ToolShape",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb2261ff07af46af68a3eebfd1a3d0100e53a4933559a8e2bae3b72c99702a6b7ed"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://schema.org/SoftwareApplication"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#Trajectory",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The observed, immutable record of the steps a work item actually took. Never edited after the fact; pruning authors a new GoldenPath, it never touches this."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Trajectory"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#UsageRecord",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Parsed token consumption: what a session actually consumed from a provider over a stated moment. A fact true at write time — aggregation into windows, rates, and per-work costs is a read-time judgment over these records."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Usage record"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#WebApplication",
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Service"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#WebApplicationShape",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb1cd39b3a3c786002bd5b2e0f4fa109307c5ba9b61774afd93ed482804ba32474b"
      },
      {
        "@id": "_:cb1df0e8f6e5e0c7c444fe8a641b090cc5f43c2982db69126af3c3c56339926aa83"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://schema.org/WebApplication"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#WorkItemScopeShape",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb16aaf65f77d2574b422e842ff7cd786230ff7eed18c26a7e9f571d8027a3e975e"
      },
      {
        "@id": "_:cb1a19d3a9f6a62a0e150613ec2a69b13984c3d3f7006ac83a4cd646ca054f37b50"
      },
      {
        "@id": "_:cb1a5c99809eaf59e329675280c73c67aefee785a5021990363e0a5a8960224a3c0"
      },
      {
