      },
      {
        "@id": "_:cb28fcf403340fb2c1a59a87fe0e47dec69f5cdcdc65a3c37f16d4a2203c76121ad"
      },
      {
        "@id": "_:cb298df7d243720447eadec311a9a206abf5467195777ef39859971eaf83666ebf7"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://schema.org/Action"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#WorkstreamShape",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb250733f67c9d43b314c08a65fbd370c56e47a157338d01a12cab6530fa492e861"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://schema.org/Project"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#about",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The entity/topic a decision concerns, when one is nameable — the anchor 'what did we decide about X' resolves against."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "about"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#aboutWorkItem",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The primary work item providing an episode's context. This is an attribution claim, not proof of implementation or completion. A producer verifies the existing target's direct WorkItem type in its authoritative records graph before writing; a reader joins that graph explicitly. The target is not copied into the episode graph. No global domain or range: neither endpoint gains a type merely from a reference."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "about work item"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#access_via",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Executable read method for source_uri: mcp, rest, sparql-federated, file, or promql."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "external truth access method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#action",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An action requested by a reaction: alert, page, bead or webhook. Multiple actions may be requested."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#actionKind",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What kind of action the step is (edit, run, mail, decide, verify, ...). One half of the conformance grammar's v1 step signature."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "action kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#actionTarget",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What the step acted on. The other half of the v1 step signature; an IRI when the target is in the graph, a string when it is not."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "action target"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#actor",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The principal that performed this step. Owed to competency golden-paths Q1; reuses whatever principal node the graph already holds."
      },
      {
        "@value": "Who or what performs a step — an agent id, a role, a team. A string rather than a reference to a Principal, because a workflow definition names roles that need not exist as entities yet. Generic name, so no domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "actor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#adversariallyProvenBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Verification that deliberately sabotaged the mechanism under test and observed this check flip. Owed to Q4: a check proven able to fail is a different evidence class from one asserted to work — the property camayoc-104 established for the gate probes, now recordable about anything else."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "adversarially proven by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Verification"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#aegis",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#RuleSet"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#defaultPrefix": [
      {
        "@value": "http://aegis.gastown.local/ontology/"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#afterHours",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What happens outside declared hours: \"deny\", or \"defer_within_window\". There is deliberately no allow: an after-hours ALLOW is the default-allow-under-load SARC §5.3 names as the opposite of oversight, and it is left unrepresentable for the same reason onTimeout is."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#OperatorGroup"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "after hours"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#amendedDigest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "sha256 over the RDFC-1.0 form of the registration as the amending write leaves it, or \"revoked\". The gate recomputes it from the post-write state; a mismatch covers nothing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#RegistryAmendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amended digest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#amendmentNonce",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Single-use, at least 128 bits of hex. Spent in the amending write; a replayed amendment is refused."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#RegistryAmendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amendment nonce"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#amendmentSignature",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The enrolled human key's signature over quipu-registry-amendment-v1|store id|registration|digest|nonce. Binding the store id stops an amendment signed for one store being replayed into another; binding the digest means it authorizes exactly one resulting registration, not whatever the write happens to contain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#RegistryAmendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amendment signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#amendmentSigner",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The verifier name of the human key that signed the amendment. It must have been enrolled for urn:quipu:policy:trust-root BEFORE the amending write."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#RegistryAmendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amendment signer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#amends",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The human-tier registration a signed amendment changes, adds or revokes. Exactly one per amendment, so a single signature can never authorize changes to several registrations."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#RegistryAmendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amends"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#appliesTo",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A repo-relative path glob scoping WHERE an action-boundary policy binds — the half of the seam yupana's projection had asked for since Phase 4 and quipu never declared. Genuinely multi-valued: a policy scoped to three globs carries three values, and the consumer accumulates them. Absent means unscoped. On a policy with no selector and no predicate this is the whole condition — a TRIPWIRE, where touching the path is the crossing. No rdfs:domain on purpose: the term reads the same on a Policy today and on a TextRule or Directive tomorrow, and a materialised wrong type outlives a missing one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "applies to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#artifactDigest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A deterministic digest of the installed artifact an ExecutionPath actually executes. Owed to Q12, which compares the two sides of a path in the store. Not aegis:contentHash reused: Q12 needs the two sides distinguishable on one node, and contentHash is a single reconciler identity (one value, Metric shape)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "artifact digest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#assignsWorkflow",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The workflow a \"require-approval\" or \"escalate\" effect routes to. Declaring the route on the constraint is what separates an escalation from a refusal: a policy that escalates without naming where is a denial with extra words."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "assigns workflow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Workflow"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#atStep",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The WorkflowStep a transition happened at. (Q3)"
      },
      {
        "@value": "The declared WorkflowStep at which a TransitionEvent occurred, connecting an observed transition back to the definition's prescriptive structure."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TransitionEvent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "at step"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowStep"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#attestationSignature",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Cosign-compatible signature binding the registered signing key to the attestation's canonical claim for independent verification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#attests",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What this registration vouches for — a compact policy id string or a governed subject IRI such as a workflow definition. Human-authored, and the root of trust: nothing in the automated path may mint one, or the chain verifies only against itself."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#VerifierRegistration"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "attests"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#attestsBundle",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Certified share bundle whose authorship and canonical graph hash a publisher attestation cryptographically binds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#CertifiedShareBundle"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#attributedTo",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The WorkItem this consumption was spent on. Optional and honest: unattributable consumption stays a session fact rather than being forced onto the nearest item. This edge is what turns cost into a property of WORK (Q16, Q18, Q21) instead of a property of a time-window."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "attributed to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkItem"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#authorityOver",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A named graph this principal may write, or \"*\" for every graph. Repeatable. The effective authority of a call chain is the INTERSECTION of every link's, so adding a delegate can only narrow it and a sub-agent cannot use credentials broader than its caller's. A principal with no authorityOver holds NOTHING — an absent grant is not permission."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Principal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "authority over"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#backoffFormula",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The backoff a \"throttle\" effect applies to SUBSEQUENT actions once a soft window has been crossed. Present so a throttling constraint declares its response rather than leaving the amount to whoever implements it; the consumer compiles the expression."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "backoff formula"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#blessingLevel",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The level this event promoted the path to: candidate, advisory, blessed, or constraint-backing. Recorded levels below candidate do not exist — recorded and verified are mechanical states derived at read time, not promotions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "blessing level"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#blockedOn",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What this work item cannot proceed past: another WorkItem (a tracker dependency), or a Blocker condition with a checkable resolution (internal source reference). Owed to Q7: with aegis:closedAt already modelled, this one edge makes 'blocked on a dependency that already cleared' a read-time join — the measured 14-day-blocked-on-a-cleared-dependency failure. The edge is the stated dependency; whether it still holds is a query, never a stored judgment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "blocked on"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#blockerEvidence",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether a Blocker is stated (a report or ticket claim) or built (a constructed failing case). Readers must not present stated as demonstrated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "blocker evidence kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#blockerKind",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What a Blocker condition waits for: release-installed, pr-merged, ci-green, human-action (a Decision Desk card) or date."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "blocker kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#boundary",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether this constraint governs a dispatched ACTION (\"action\") or a state CHANGE (\"transition\"). The coarse split; aegis:verificationPoint is the fine placement within it. Only action-boundary policies have an enforcement point a trace record can traverse, which is why the placement check and the audit checker both scope to them."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "boundary"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#by",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Who made a decision. Range and comment only — `by` is far too generic a name to materialise a type from, whatever this vocabulary happens to use it for today."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#byteCount",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Total size in bytes of the regular files in the collection's subtree at crawl time (apparent size from stat, not blocks used on the pool)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "byte count"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#calibrationBasis",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What the threshold is measured over, so a reader can tell a rolling spend cap from a symbol count without reading the claim."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "calibration basis"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#candidateSource",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Where a grounded predicate's candidates come from. \"token\" — the shipped value — means the tokens of the introduced text, which the parser has already produced and which assume no lexical shape. A pattern value remains expressible purely as a narrowing optimization (fewer membership probes); it is NEVER authority. Whatever picked the candidates, one grounds if and only if the graph holds it: the groundingQuery's id set alone defines what a reference looks like."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Predicate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "candidate source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#canonicalGraphHash",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Quipu pack_manifest content_hash: sha256 over lexically sorted N-Triples for graph, shapes, queries and labels; the knowledge-state identity shared across git, OCI and object storage."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#certificationSeal",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The independent Quipu conformance seal attached to a certified share bundle after shape validation and outward-share scrubbing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#KnowledgeCertificationSeal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#certifiesBundle",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Certified share bundle whose shape conformance, scrub result, and canonical graph hash a Quipu certification seal binds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#CertifiedShareBundle"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#chose",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What was chosen. The one property a Decision cannot lack."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "chose"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#claim",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A SPARQL ASK whose truth is the thing asserted. On a Policy it is the predicate that decides compliance; on an Artifact it is what the artifact asserts about itself. No rdfs:domain: the word means the same thing in both places and asserting either class would materialise the wrong one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#condition",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A reaction condition expressed as SPARQL SELECT ?focus. Query failure means unknown, not resolution. An adapter may interpret the result as its candidate population."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#confidence",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How much weight the verdict's evidence bears, as an input to adaptive response. Distinct from aegis:tier, which says what KIND of evidence it was; the same tier can carry different confidence depending on how much of the subject the check could see."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Verdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#constraintClass",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What KIND of bound this constraint is, independent of what happens when it fires: \"hard\" (never admissible under any policy), \"soft\" (admissible at a declared cost), or \"escalation\" (control transfers to a human). Distinct from aegis:effect, which is the RESPONSE. The two were one field until Q-SARC-CLASS, and collapsing them is what made \"may this action ever execute?\" a question the graph could not answer."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "constraint class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#contentHash",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A deterministic hash of the source definition used by reconcilers to distinguish unchanged from changed catalogue entries."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "content hash"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#corpusWatermark",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Which state of the comparison corpus a sealed similarity score was computed against — a transaction id (\"tx:41\"), a snapshot hash, an index generation. The corpus half of the trust-chain rule: re-embedding against a corpus that has since changed is honestly a DIFFERENT comparison, and the watermark is what lets a re-verifier notice that instead of reporting a spurious mismatch. No rdfs:domain — any sealed similarity record may carry it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "corpus watermark"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#createdAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "When an entity was created, serialized in the producer's canonical timestamp form; generic enough to carry no materialising domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "created at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#currentRevision",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Monotone count of committed advances for this run; it changes atomically with the signed event so returning to a state cannot admit an old request."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#currentState",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A convenience projection of a WorkflowRun's latest append-only TransitionEvent, re-asserted rather than mutated so event history remains the truth."
      },
      {
        "@value": "A run's state, re-asserted per transition and read by latest valid_from. Derived from TransitionEvents, which remain the truth; never updated in place (append-only rule). (Q1, Q2, Q4)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowRun"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "current state"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#deadEnd",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The entry Step of an abandoned branch the exemplars explored, preserved as a hazard: a follower of this path should know what was tried that did not help. Negative knowledge, kept queryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "dead end"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#decidedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "decided by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#decidedIn",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The work item (or session) a decision was made under."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "decided in"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#decisionPolicy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The predicate a verifier must be registered to attest before its signature can seal this decision. Distinct from aegis:forPolicy, whose domain is DecisionRequest."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "decision policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#demonstratedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Verification or other observed record that constructed and demonstrated a built blocker."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "demonstrated by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#dependsOnVariable",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A variable the mechanism under test depends on, named by the check that established the dependence. Owed to Q5: a test in an adjacent setting is valid exactly when the mechanism does not depend on what differs — this edge is what lets that be asked instead of assumed, protecting good evidence from being discarded (incident forms A2, A6)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "depends on variable"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#depends_on_transitive",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Rule"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#body": [
      {
        "@value": "depends_on(?a, ?b), depends_on(?b, ?c)"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#head": [
      {
        "@value": "depends_on(?a, ?c)"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#id": [
      {
        "@value": "depends_on_transitive"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#derivedConstraint",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The aegis:Policy this GoldenPath backs, closing the audit chain constraint <- path <- exemplars. Far-horizon: gated on verdict signing; until then the ladder honestly stops at blessed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "derived constraint"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#deviatesAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Step at which an evaluated trajectory departed from the path it declared. Deviation is input to the record, not a judgment that the agent was wrong — demotion evidence only exists if deviations are recorded faithfully."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "deviates at"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#dispatchedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What dispatches this class of action — a harness, a daemon, a CI runner. Two classes with the same name under different dispatchers are different classes, because only one of them may traverse a hook."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "dispatched by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#effect",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The RESPONSE when this constraint fires: \"allow\", \"warn\", \"require-approval\", \"deny\", \"escalate\", \"record\" or \"throttle\". Distinct from aegis:constraintClass, which is what kind of bound it IS. A hard constraint declaring \"warn\" is a contradiction the class exists to make visible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "effect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#embeddingModel",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The identity of the embedding model that produced a sealed similarity score — the model half of the trust-chain rule applied to embeddings: a score is reproducible only under the model that computed it, so a verdict that omitted this would be unfalsifiable the moment the deployment swapped models. No rdfs:domain, same shared-carrier reasoning as aegis:similarityScore."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "embedding model"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#enabled",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether the carrying rule is enabled. Chaski treats omission as enabled; this is a consumer default, not an asserted graph value."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "enabled"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#enacts",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Decision this step enacts, when one was recorded."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "enacts"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#enforcedInsteadAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Where enforcement happens for a class that cannot be governed here — a VCS hook, branch protection, destination-side credentials. An acknowledged bypass surface with no stated alternative is a note that something is unhandled; with one, it is a design."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "enforced instead at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#enrolled",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The registration a one-time console bootstrap enrolled as the first human key. The bootstrap can run once per store, ever; every later key is an amendment signed by an enrolled one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TrustRootBootstrap"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "enrolled"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#eventId",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Stable producer event identity. For a ReactionFiring, derive its IRI from the reaction label and this event ID, preserving the same payload on retries. No domain: events and other records may carry this identity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "eventId"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#eventTypes",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Comma-separated event types selecting which feed events trigger a reaction evaluation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "eventTypes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#evidenceHash",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A digest of exactly what was judged, binding an attestation to its content. Change what was checked and the hash changes, so the old verdict or approval no longer applies — this is the approve-then-sneak-in-changes defence, and Verdict, Decision and DecisionRequest all use the same one rather than three mechanisms."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "evidence hash"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#evidenceSource",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The concrete artifact that produces the evidence — a tree-sitter `.scm` query on a Selector, a regex on a Predicate. Named `evidenceSource` rather than `query` or `pattern` because the point is provenance: an evaluator must be able to say WHERE a fact came from, not only what it was."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "evidence source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#executable",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether invoking this class can change state. A read-only class needs no enforcement point, and demanding one would bury the real gaps under the ordinary case. An ABSENT value is not false: whether the class needs a point is then undecidable, and the inventory check says so rather than assuming safety."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "executable"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#executesArtifact",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The installed artifact that this ExecutionPath actually invokes. This is the execution target, not a claim that it is currently live."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "executes artifact"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#exemplar",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The concrete record that motivated this policy — a Verdict, a DecisionRequest, a verdict-spool entry, an edit someone ruled \"never again\" on — as an IRI string. Policy-by-example provenance (docs/design/policy-by-example.md): a drafted rule records its motivating case so a later refusal under it can cite the example that birthed it, completing identify-and-inform-before-refusing. A string rather than an object reference because the exemplar may live outside this graph (yupana's spool), and optional because a hand-authored policy has none — an absent exemplar is honest absence, never forged provenance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "exemplar"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#exemptLineMarker",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A literal marker which, present on the same introduced line as a match, exempts that match, for text that names a pattern on purpose such as an incident runbook. Literal rather than a regex so the exemption stays explicit and greppable; RE2 has no lookaround to fold it into aegis:regex."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TextRule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "exempt line marker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#exemptPathRegex",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A regex over the edited file's REPO-RELATIVE path; a match exempts that edit from the rule (e.g. the ratchet tests that must name a forbidden token to forbid it). Already used by live rule data; declared here so it is governed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TextRule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "exempt path regex"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#exemptRepo",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A repository, by its canonical repo name (e.g. an infrastructure repo), in which this text rule does NOT apply. Repeatable. Matched against the repo identity the evaluator resolves for the edited file (its origin repo name), never a directory name, so every worktree of that repo is exempt. An edit whose repo cannot be resolved is NOT exempt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TextRule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "exempt repo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#expiresAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Unix seconds after which an unserviced request is DENIED, derived from the constraint's reversibility window. Required: a request with no expiry is the unbounded escalation SARC I4 forbids — the point at which the absence of a ruling becomes an answer has to be declared."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionRequest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "expires at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#extensionCounts",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Compact histogram of the subtree's extensions, as .ext=count pairs separated by spaces, largest first. A summary for readers; hasExtension is the queryable form."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "extension counts"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#falseNegativeTolerance",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The rate of admitted-but-violating actions this deployment accepts. Zero for an exact predicate; a hard constraint with an inexact predicate should carry a tolerant false-positive number and a near-zero one here, never the reverse."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "false negative tolerance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#falsePositiveTolerance",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The rate of blocked-but-valid actions this deployment accepts. For a hard constraint the asymmetry normally favours tolerating false positives: a missed violation is by definition unacceptable, while a wrongly blocked action falls back to escalation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "false positive tolerance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#falsifier",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The observable result that would have disproved a Verification. Mandatory: a check that cannot name its failing result is an assertion, not verification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "falsifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#fileCount",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Number of regular files in the collection's whole subtree at the time of the crawl. Symlinks are not followed, so a link to elsewhere is not double counted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "file count"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#firedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Reaction whose transition produced this firing record."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "fired by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Reaction"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#focus",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The IRI that a reaction condition or adapter identified as the focus of a firing. No range class: any IRI may be a focus."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "focus"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#followsPath",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A trajectory's (or work item's) declared claim to be an instance of a GoldenPath. A claim, not a verdict — conformance is evaluated at read time and by the guard, never asserted by the follower."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "follows path"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#forDecision",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The decision a presentation freezes. Its content is hashed at presentation and re-hashed at every verification, so this link is what an edit to the decision is detected through."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionPresentation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "for decision"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#forPolicy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The policy whose escalation opened this request. Recorded on the request rather than inferred from the evidence hash, so an operator can see WHAT rule they are being asked to rule on without recomputing anything."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionRequest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "for policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#forPresentation",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The presentation a sealed verdict answers. The verdict inherits that presentation's frozen digest, nonce and expiry, all of which were inside the challenge the approver signed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionVerdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "for presentation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionPresentation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#forTarget",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The entity whose write was suspended awaiting a human ruling. Together with aegis:forPolicy this is the whole subject of the request, and the pair is exactly what the evidence hash binds an approval to."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionRequest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "for target"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#freshness",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Freshness of a claim relative to its source. VerdictShape constrains verdicts to fresh|stale; ExternalTruthMappingShape constrains mapped external truth to live|snapshot(ts)|frozen(window). No rdfs:domain: the predicate intentionally serves both carriers, and a domain would incorrectly retype every mapped Artifact, Metric, service or document as a Verdict."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "freshness"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#fromRevision",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The run revision the performing agent signed as the prerequisite for this advance; it must match the committed current revision before the event is accepted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#fromState",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The state a TransitionEvent left, retained on the event so archived history can be replayed without reconstructing a prior mutable status."
      },
      {
        "@value": "The state a transition left. Carried on the event so history needs no reconstruction. (Q3)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "from state"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#frozenWindow",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Source shuttle window for a certified bundle cut from frozen operational data; omitted by static packs."
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#gate",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A secondary condition narrowing when the check applies. NB this property is used in TWO senses in this vocabulary — a Predicate's applicability gate, and the gate that produced an aegis:Decision — which is why it carries no rdfs:domain. Two meanings under one name is a defect worth recording rather than hiding; splitting them is a vocabulary change with a migration behind it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "gate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#gatedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A policy that must be satisfied before this step proceeds. Ranged at Policy but undomained: a policy can gate more than a workflow step."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "gated by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#gatedTx",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The committed transaction whose delta a verdict judged, not the transaction persisting that verdict. Optional and positive; refused or rolled-back attempts and historical verdicts omit it. Never predict an attempted id or guess a backfill. IDs are local to the originating store. A producer must bind the link into signed evidence and verdict identity. No domain: another audit record may also name a judged transaction without becoming a Verdict."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "gated transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#gates",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The alert, release, or decision surface gated by this metric."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "gates"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#git_commit_subsumes_commit",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Rule"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#body": [
      {
        "@value": "<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>(?x, <http://aegis.gastown.local/ontology/Commit>)"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#head": [
      {
        "@value": "<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>(?x, <http://aegis.gastown.local/ontology/GitCommit>)"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#id": [
      {
        "@value": "git_commit_subsumes_commit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#governedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An enforcement point this class actually traverses; repeatable, since a tool call can pass a pre-action gate and a post-action auditor both. Same value space as aegis:verificationPoint deliberately — a constraint placed at a point no class traverses can never fire, and that is only checkable if the two are one enum."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "governed at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#groundingQuery",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The authoritative id set behind a grounded match type, as a SPARQL SELECT (e.g. every aegis:WorkItem's identifier). Truth is membership in its result, not resemblance to a pattern. Evaluators never run it per candidate: it is projected into the hot plane as a membership set under the existing freshness machinery, and a missing or failed projection renders the rule UNEVALUATED and loud — never \"empty set, nothing grounds, allow\", which would convert an outage of the grounding plane into silent permission."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Predicate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "grounding query"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#hasExtension",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A lower-cased file extension, with its leading dot, present anywhere in the collection's subtree. Multi-valued. It is what lets a query find the collection holding .z64 files without a crawl."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has extension"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#hasStep",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A WorkflowDefinition's declared step. (Q5)"
      },
      {
        "@value": "A step belonging to this workflow. The only structural link between a workflow and its steps: a Step with no workflow pointing at it is unreachable, and nothing else in the vocabulary would notice."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Workflow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has step"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Step"
      },
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowStep"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#hostedAtLayer",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The architectural layer that HOSTS the check: \"orchestration\" (code in the planner or dispatcher), \"tool\" (inside the tool implementation), or \"policy\" (outside the agent process entirely). There is deliberately no \"prompt\" value: a constraint expressed as an instruction the model may reinterpret or route around is not enforcement. NB the omission is defence in depth, not a guarantee — it is refused on quipu's write path by the placement check, and nothing can make a value unwritable to a store opened directly."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hosted at layer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#idleLimit",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An ISO-8601 duration (PnW, or PnDTnHnM) a tracked WorkItem may go without tracker activity. Anchored on the observedAt of its latest tracker Observation (aegis:observes); a latest observed status of closed or deferred resolves it. No Observation means UNKNOWN, never fresh and never due."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "idle limit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#implements",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A provenance claim that this thing (a commit, an episode, a bead close) realises the cited work item. A CLAIM, deliberately — writing the edge asserts nothing about its truth; verify_claimed_linkage (src/governance/linkage.rs) checks the claiming content's similarity against the cited item's description and types the answer grounded / cited-but-dissimilar / no-citation, which is what turns this edge from trusted to checkable. No rdfs:domain: many kinds of thing legitimately claim to implement work, and a domain would materialise a wrong type on all but one of them."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "implements"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkItem"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#importsUntrustedState",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether this class brings state INTO the agent's context that has not been through this deployment's constraints — a sub-agent's response, a retrieval result, an MCP tool's output. An importing class that traverses no enforcement point is strictly worse than an ungoverned class acting locally: it is a channel by which unchecked content enters and is then acted on."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "imports untrusted state"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#inExport",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The NFS export a FileCollection was crawled from. The collection's relativePath is relative to that export's root, so the pair locates it without touching the filesystem."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "in export"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#inRun",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The WorkflowRun a TransitionEvent belongs to. (Q3)"
      },
      {
        "@value": "The WorkflowRun whose append-only history contains this TransitionEvent, allowing readers to reconstruct state without mutable status facts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TransitionEvent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "in run"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowRun"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#inSession",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Session a UsageRecord was parsed from. Mandatory in the shape: an unattached record can join against nothing, and Q19's absence test needs every present record anchored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "in session"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Session"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#inStep",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The workflow step a plan step belongs to. What lets a concrete plan be checked against the workflow it claims to be executing, rather than only against itself."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "in step"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Step"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#inWorkflowRun",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The WorkflowRun a WorkItem was created to carry out: shuttle creates a work item for a step of its run and advances the run when the item closes. The sibling of aegis:inRun (TransitionEvent -> run); reconcile reads the item's aegis:outcome, never its prose (internal source reference C2, internal source reference)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "in workflow run"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowRun"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#inheritedByDelegates",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether this constraint binds the whole subtree under a dispatch rather than only the agent it was written for. Constraint LAUNDERING is the failure it addresses: an orchestrator bound by a rule dispatches a sub-agent, the rule is not re-applied at the deeper layer, and the action happens anyway — nobody decided to drop it, it simply was not carried."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "inherited by delegates"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#initialState",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "State entered by a newly created run of this workflow; direct processing checks the run starts here before any signed advance is admitted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#keyFingerprint",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "SHA256 fingerprint of the bootstrapped key, as ssh-keygen -lf prints it. The ceremony compares it with the device; a mismatch means someone else bootstrapped first."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#TrustRootBootstrap"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "key fingerprint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#kind",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How this operating point is expressed: \"exact_predicate\" (a string, regex or typed comparison with no classifier and so no score to threshold), \"threshold\" (a numeric cut), or \"deterministic_threshold\" (a threshold over an exactly-known quantity)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "operating point kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#language",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The programming language whose grammar this selector's query is written against. A selector without one cannot be matched to a file, and hank skips it rather than guessing from an extension."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Selector"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "language"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#lastRefreshedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The observed time the execution path was last refreshed. It is evidence for a read-time currency query, never a stored current/correct verdict."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "last refreshed at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#latencyBudgetMs",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Wall-clock budget for evaluating this constraint at its verification point. Exists to keep constraint evaluation on the order of tool latency and never model latency: a check that needs another model call both doubles per-step latency and inherits the nondeterminism the check was supposed to bound."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "latency budget (ms)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#leadFor",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pairs a review/design LEAD with the KEEPER whose domain it reviews, 1:1 from both ends. Not reports_to: it routes design and review work, not the stop-event tree (internal source reference). No rdfs:domain or rdfs:range on purpose: the roles are asserted with aegis:hasRole and checked by LeadForShape, so inference must not type anyone as a lead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "lead for"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#linkageOutcome",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What kind of grounding answer a claimed-linkage check gave: \"grounded\" (the claim is similar to its cited item at or above threshold), \"cited-but-dissimilar\" (a real item cited, content not near it — a fabricated linkage, its own violation class), or \"no-citation\" (nothing cited, or the citation resolves to nothing). A closed three-value set, deliberately WITHOUT an unevaluated value: a check that could not run records outcome \"unknown\" and no linkageOutcome at all, keeping the existing unknown semantics single rather than duplicated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Verdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "linkage outcome"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#matchType",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How the predicate's evidence is read. The lexical trio — \"must-match\", \"must-not-match\", \"must-exist\" — tests text against a pattern (`must-exist` is the one that cannot be evaluated over an edit fragment, which is why it belongs at the post-action point). The grounded pair — \"must-ground\", \"must-not-ground\" — tests candidates for MEMBERSHIP in the id set the predicate's aegis:groundingQuery names, with three outcomes: grounded, unresolvable (a fabricated reference, its own violation class), and no-candidate."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Predicate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "match type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#maxAge",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An ISO-8601 duration (PnW, or PnDTnHnM) the entity may go without a fresh check. Anchored on the latest aegis:verifiedAt of a Verification that aegis:verifies it; with no such verification the age is UNKNOWN, never fresh and never due."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "max age"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#meanServiceSeconds",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Mean time to rule on one request. With operatorCount this is enough to compute the expected queue wait and compare it against a constraint's reversibility window."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#OperatorGroup"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mean service time (s)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#meaning",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "meaning"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#measurementWindow",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "measurement window"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#measuresRequirement",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A Metric's claim that its probe tests a NonFunctionalRequirement. Keeping this as a claim makes invalid and orphan instrumentation queryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "measures requirement"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#metricName",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The measurement-system series or expression identity parsed from the source rule."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "metric name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#minVersion",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "For a release-installed Blocker: resolved when the installed tool reports a version at or above this."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "minimum version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#name",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A short human handle for an evidence atom. No rdfs:domain: Selector and Predicate both carry it, and the name is far too generic to materialise a type from."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#newestMtime",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The most recent modification time of any file in the subtree, as UTC YYYY-MM-DDTHH:MM:SSZ. Answers when a collection last changed without listing it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "newest mtime"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#nonce",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The single-use value quipu minted for a presentation. Spent when a verdict over it is accepted, so the same signature cannot be accepted twice."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionPresentation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "nonce"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#observedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "observed at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#observedBlockedOn",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A tracker `blocks` dependency, as of this Observation. Only the work item's LATEST Observation counts, so a dependency removed in the tracker stops blocking without any retraction."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "observed blocked on"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#observedClosedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "When the tracker recorded the work item closed, as of this Observation. Absent means not closed as of this Observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "observed closed at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#observedStatus",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The tracker's status token for a work item (open, in_progress, blocked, deferred, closed, ...) as of this Observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "observed status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#observedValue",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "observed value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#omissionAuthority",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What authorized the cut: cone-analysis (the step is outside the provenance cone of the verified result — mechanical) or human-decision (a human overruled or supplemented the cone; omissionRuling names the Decision). Mandatory — an omission that cannot say who cut it is a silent edit of history."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "omission authority"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#omissionRuling",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The human Decision behind a human-decision omission, with its rationale."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "omission ruling"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#omitsStep",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A PathOmission node recording one pruning ruling this GoldenPath made."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "omits step"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#omittedStep",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Step a PathOmission excludes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "omitted step"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#on",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The event a transition fires on. About as generic a name as this vocabulary contains, so range and comment only."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "on"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#onTimeout",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What happens when the reversibility window elapses with no operator ruling. The only permitted value is \"deny\". Default-allow under operator unavailability converts an escalation constraint into a no-op exactly under the load that made it matter, which is the opposite of oversight — so this is a fail-safe, not a fail-degraded, default."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "on timeout"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#onUndecidable",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What happens when an inherited constraint reaches a layer that cannot evaluate it. The only permitted value is \"escalate\" — there is deliberately no \"drop\", because a constraint that silently stops applying where it cannot be checked is one an agent escapes by dispatching into a context where the evidence is absent. The decidability RESCUE: evaluate at the deepest layer where it still decides, or hand it to a human."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "on undecidable"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#operatingPoint",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The declared false-positive / false-negative posture of this constraint's predicate. Required for a complete constraint: the FP/FN trade-off is a decision the deploying organization owns, not a default chosen by whoever wrote the regex, and a predicate without one is under-specified in a fiduciary sense as much as a technical one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "operating point"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#OperatingPoint"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#operatorCount",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Servers in the M/M/c sense — how many operators can rule in parallel. Part of the specification rather than an unstated operational assumption, because SARC §5.3 makes the expected wait a MEASURABLE property and a queue with undeclared parameters cannot be measured against a reversibility window."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#OperatorGroup"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "operator count"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#option",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One outcome the decision offers. Repeatable. When a decision declares options, a sealed verdict must choose one of them; the chosen outcome is inside the signed challenge."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "option"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#outcome",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What actually happened: done, abandoned, superseded, failed. Distinct from the decision that aimed at it. Set at close; absence means open — never store a decaying 'in progress'."
      },
      {
        "@value": "What was concluded. Three-valued on a Verdict — \"satisfied\", \"unsatisfied\", \"unknown\" — where \"unknown\" is NOT a soft \"unsatisfied\": a check that could not run has told you nothing, and collapsing the two is how an unevaluated constraint reads as a passing one. On a Decision the values are \"approve\", \"reject\" and \"changes\". No rdfs:domain, since both classes carry it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "outcome"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#over",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The alternatives visible when the decision was made. Absence means none were articulated — which is itself a fact worth knowing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "over"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#ownedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The principal that owns the path location. A single-principal owner is observable execution-path risk, not a liveness judgment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "owned by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#parentCollection",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The enclosing FileCollection, e.g. a season's show or an album's artist. Its counts and extensions include this collection's, because every aggregate covers the whole subtree."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "parent collection"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#performedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The agent (an aegis:Principal or crew-member IRI) that performed and signed a transition. Paired with aegis:signature — the hex ed25519 signature over the canonical shuttle-transition-v1 message — verifiable against the agent's aegis:VerifierRegistration in the identity graph. signature/publicKey/verifier/VerifierRegistration are quipu-owned aegis terms, reused not re-minted. (Q6, Q7, Q8)"
      },
      {
        "@value": "The principal that performed and signed an event; shared by workflow history and any later attested activity, so it carries no materialising domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "performed by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Resource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#planePromotion",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Attaches a promotion record to the fact that was promoted. The record is a blank node carrying the move's own provenance as observed facts — the promotion IS an observed event even though the fact it moved was inferred. No range: the record is structural, not a class anyone types. (Q13)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "plane promotion"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#prRef",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "For a pr-merged Blocker: owner/repo#number. Resolved when that pull request is merged."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "pull request reference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#precedent",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A scored nearest-neighbour claim attached when this request was minted: a prior DECIDED request (one holding a signed ruling from a registered decider) similar to this one, so the operator rules with \"you rejected something similar, here is why\" in view. Advisory only — the ruling stays the human's — and absence means no similarity method ran or nothing was near, never that precedent was checked and cleared."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionRequest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "precedent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#PrecedentLink"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#precedentRequest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The prior decided DecisionRequest a precedent link points at. Kept on the reified link rather than directly on the new request because the link also carries the score and method for THIS pairing, and several precedents on one request would otherwise leave scores nobody can pair with their subjects."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#PrecedentLink"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "precedent request"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionRequest"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#predicate",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What must be true at the selected sites — the WHAT half. SARC's `pred` field, and the only part of a constraint whose language is deliberately unconstrained: the audit checker is predicate-language-agnostic by design."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Predicate"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#predicateId",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Which predicate this verdict is about, by id. The verdict names the check rather than embedding it, so a re-run against a changed predicate is visibly a different verdict."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Verdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicate id"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#presentationExpiresAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Unix seconds after which the presentation can no longer be answered. Inside the signed challenge, so the approver sees and signs it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionPresentation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "presentation expires at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#principalId",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The stable identifier a principal-and-agent call chain names. Distinct from the entity's IRI so a chain can be carried as short strings across a process boundary without minting IRIs at every hop."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Principal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "principal id"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#probe",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The actual expression evaluated. An alert name is never a substitute for this mechanism."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "probe"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#probeValidatedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A falsifier-gated Verification that demonstrated the probe changes when the requirement is violated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "probe validated by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#produces",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An artifact this step yields. No rdfs:domain: `produces` is a relation many things in an estate can hold."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "produces"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Artifact"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#promotedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "promoted at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#promotedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The principal whose act this promotion is. Mandatory, and a human: nothing above verified happens without a recorded human act."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "promoted by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#promotedFrom",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The plane graph the fact left. Always crew:inferred today — promotion is out of quarantine — and recorded rather than assumed, so a later reader is not required to know that. (Q13)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "promoted from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Resource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#promotedInto",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The plane graph the fact entered. (Q13)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "promoted into"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Resource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#promotes",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The GoldenPath this promotion event acts on."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "promotes"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#promotionEvidence",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What the promoter looked at: a backtest report, a Verification, an advisory-period conformance record. A promotion citing nothing is answerable to competency Q8 as exactly that."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "promotion evidence"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#provenanceManifest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Manifest IRI describing the sources and production lineage of a certified bundle or seal."
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#provider",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The provider whose tokens a UsageRecord counts. On the record, not the session: one session may consume from more than one provider, and Q17/Q20 group by exactly this."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "provider"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#prunedFrom",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The exemplar Trajectory this GoldenPath was distilled from. Mandatory: a path that cannot cite the concrete success that justifies it is an opinion."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "pruned from"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#publicKey",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The ed25519 public key a verifier's signatures check against. Human-authored, and the reason a verdict is an attestation rather than a claim: nothing in the automated path may write one."
      },
      {
        "@value": "quipu-owned. The key a VerifierRegistration registers. Reused by workflow-and-archive Q6, which is a GAP for a reason this term cannot fix: SPARQL can retrieve the key and cannot evaluate the signature against it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#VerifierRegistration"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://github.com/scbrown/quipu"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "public key"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#publisherAttestation",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The publisher-authorship claim attached to a certified share bundle, independently verifiable with its registered publisher key."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#PublisherAttestation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#purpose",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The purpose tag bound into the signed challenge (quipu-verdict), so a signature made for a decision cannot be replayed as another kind of attestation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionPresentation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "purpose"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#question",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What a human is being asked to decide, in the words they will see. Part of the sealed content: changing it after presentation invalidates the presentation and any verdict over it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "question"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#rationale",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "rationale"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#reference",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A pointer to where an artifact actually lives — a path, a URL, a commit. Deliberately opaque: the graph records that an artifact is referenced somewhere resolvable without becoming a second copy of it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "reference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#references",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A code symbol a plan step names. What makes a plan checkable against structure rather than against prose."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "references"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#CodeSymbol"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#refreshedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The mechanism responsible for refreshing the execution artifact from its source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "refreshed by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#relativePath",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Path of a FileCollection relative to its export's root, with no leading slash. Stable across re-crawls, so it keys the collection's identity together with the export."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "relative path"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#repoRef",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "For a ci-green Blocker: owner/repo@branch. Resolved when the branch's latest completed CI run succeeded."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "repository reference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#repositorySource",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The source artifact that should correspond to the executed artifact. Comparing these at read time detects armed-not-running drift."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "repository source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#requires",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An artifact this step needs before it can run. No rdfs:domain, for the same reason as aegis:produces."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "requires"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Artifact"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#resolutionQuery",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A SPARQL ASK that is true exactly when the Blocker has resolved. An ASK that cannot be answered makes the Blocker's state unknown, never resolved."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "resolution query"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#resolvedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Resolution instant of an occurrence. For a ReactionFiring this is absent while active and set once on resolution; SHACL cardinality cannot enforce that temporal transition."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "resolvedAt"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#resolvesOn",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "For a date Blocker: the date from which it is resolved."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "resolves on"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#date"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#reversibilityWindowSeconds",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The time within which the contemplated action can still be undone without compounding cost. An escalation whose expected queue wait exceeds this window is structurally too slow however diligent the operator: the architect must tighten the predicate, add capacity, or convert the constraint to a hard block. Required on escalation-class constraints — an escalation without a bound is not human oversight, it is deferred autonomy."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "reversibility window (s)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#reviewAfter",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An ISO-8601 instant after which this entity is DUE for re-checking: the fact is to be re-verified, not trusted. Applies to any entity; a claim is aged through its own node."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "review after"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#routedTo",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Which operator group can rule on this request. Records WHO should decide; delivering the request to them is a consumer of this record, not something quipu does."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionRequest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "routed to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#OperatorGroup"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#runOf",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The WorkflowDefinition a run executes. (Q1)"
      },
      {
        "@value": "The durable WorkflowDefinition executed by this operational WorkflowRun, linking time-windowed run history back to its stable declared process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowRun"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "run of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowDefinition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#runs_on_transitive",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Rule"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#body": [
      {
        "@value": "runs_on(?svc, ?container), runs_on(?container, ?host)"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#head": [
      {
        "@value": "runs_on(?svc, ?host)"
      }
    ],
    "https://w3id.org/intigraph/quipu/ns#id": [
      {
        "@value": "runs_on_transitive"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#scrubCheckPass",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Boolean certification claim that is true only when the outward-share internal-identifier scrub completed successfully with no prohibited identifiers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#sealSignature",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The approver's signature over the quipu-decision-v2 challenge. Verified as of the transaction that recorded it (signing-plane S1)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionVerdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "seal signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#sealedDigest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "sha256 of the RDFC-1.0 canonical form of the decision's content, frozen when it was presented. Verification RECOMPUTES the digest from the stored decision and compares; a supplied hash is never trusted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#DecisionPresentation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "sealed digest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#selector",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Which sites this policy examines — the WHERE half of a structural constraint. Separate from the predicate so a selector can be reused across policies that judge the same sites differently."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "selector"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Selector"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#shaclReportHash",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Content digest of the complete SHACL conformance report, binding a certification seal to the exact validation evidence it summarizes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#shapesBundleVersion",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Stable name and version of the governed shapes bundle against which the graph was validated when its certification seal was issued."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#signature",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The ed25519 signature over the verdict's canonical form. What makes a verdict an ATTESTATION rather than a claim: a reader verifies it against a human-authored VerifierRegistration instead of trusting the process that wrote it."
      },
      {
        "@value": "quipu-owned. The hex ed25519 signature over the canonical shuttle-transition-v1 message, carried on a TransitionEvent as an ordinary fact so it survives a deep freeze. Reused by workflow-and-archive Q6 and Q7."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Verdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://github.com/scbrown/quipu"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#signingKey",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Human-gated verifier registration naming the public key used to authenticate and verify an attestation signature."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#VerifierRegistration"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#similarityMethod",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The method/model identity that produced a similarity score — e.g. \"embedding:model.onnx\", or an honestly self-naming deterministic method. This is the falsifier: a score outside its method is an assertion, a score with it is an experiment anyone can re-run. A method that cannot name itself must not put scores on record. No rdfs:domain, for the same shared-carrier reason as aegis:similarityScore."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "similarity method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#similarityScore",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The numeric result of a similarity comparison, recorded as a fact about the COMPARISON rather than about either compared thing. Meaningless without the method that produced it, so it never appears without aegis:similarityMethod (or, on a sealed verdict, the model identity) beside it — re-run the named method to reproduce or disprove the number. No rdfs:domain: any similarity claim carries it (a PrecedentLink today, a sealed Verdict next), and a domain would materialise a wrong rdf:type on the others."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "similarity score"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#similarityThreshold",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The cut a similarity score was compared against when a verdict was sealed. Recorded ON the verdict even though the declared value lives in the policy's OperatingPoint, because the verdict must stay falsifiable after the policy is re-calibrated: \"0.83 >= 0.75\" is re-checkable forever, \"0.83 >= whatever the threshold was then\" is not. No rdfs:domain — any sealed similarity record may carry it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "similarity threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#sourceDigest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A deterministic digest of an ExecutionPath's repository source, computed the same way as artifactDigest so the two compare. Owed to Q12: equal digests are observed agreement, differing digests are observed drift, and absence is UNKNOWN — never a verdict either way."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "source digest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#sourceKind",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How a fact entered the graph: observed, declared, or inferred; a trust-plane tag shared across entity classes and therefore domain-free."
      },
      {
        "@value": "How this fact entered: observed (a record exists and was parsed), declared (a human said so), inferred (a model concluded it). Mandatory; SHACL-refused when absent. Never up-tag."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "source kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#sourceLeftOpen",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether the source-plane interval was left open. false: the source episode was closed, a bitemporal interval close and never a delete, so the original stays visible as-of its write time. true: the promoter could not name the source episode, and the record says so out loud rather than implying a close that never happened — the fact is then readable in two planes at different trust, which is recoverable and visible instead of silent. The exact cell Q13 asks for. (Q13)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "source left open"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#sourceType",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What KIND of instrument this obligation comes from: \"regulatory\", \"contractual\", \"ethical\" or \"operational\". aegis:authority on the parent Directive says WHO issued it; this says what kind of thing it is, which is what decides precedence when two constraints conflict (regulatory > contractual > operational)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "source type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#source_uri",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Where an entity's external truth lives, including s3, https, file-at-revision, PromQL and MCP identifiers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "external truth source URI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#startedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The start instant of an occurrence. For a delivered ReactionFiring, use the frozen event payload observed_at, never retry send time."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "startedAt"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#stepOf",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Trajectory this step belongs to. Mandatory: a step with no trajectory is an anecdote."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "step of"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#stepOrder",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The step's position in the total order of the thing that declares it — a Trajectory's observed walk (golden-paths Q1) or a WorkflowDefinition's declared steps (workflow-and-archive Q5). Reused across both rather than minted twice, which is what rdfs:range-only and no rdfs:domain is for."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "step order"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#supersededBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A later decision that replaces this one. The old decision is never deleted — bitemporality keeps it; this edge says who won."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "superseded by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#targetRef",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What the verdict was rendered about — the entity, file or symbol judged. Recorded separately from the evidence hash: the target says WHICH thing, the hash pins WHAT STATE of it was seen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Verdict"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "target ref"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#targets",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The class of entity this policy applies to, as an IRI string. What a policy is ABOUT, as opposed to what evidence decides it (aegis:claim, aegis:selector, aegis:predicate)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "targets"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#terminalState",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A state in which this workflow finishes; the declared process must contain no outgoing step from any terminal state."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#threshold",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The declared comparison and bound that makes a nonfunctional requirement testable."
      },
      {
        "@value": "The numeric cut this operating point applies, in the units of its calibration basis."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      },
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#tier",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How precise the evidence behind a fact is: \"live\", \"lsp\", \"tree-sitter\", \"committed\" or \"attested\" — plus, on Predicate AND Verdict, the grounded ladder of \"tree-sitter+graph\" (exact membership, hard-capable), \"embedding\" (reproducible but approximate; advisory or escalate, never a hard PAG deny) and \"model\" (generative judgment, last resort). The tier rides the verdict into the graph: a similarity verdict records tier \"embedding\", never an exact tier's label. Carried by Selector, Predicate AND Verdict, so no rdfs:domain. Every fact this stack serves is tagged, and an approximation is never presented as exact."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "tier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#to",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The step a transition leads to. Together with aegis:on — the event — this is the whole of a transition: what happened, and where it goes next."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Step"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#toState",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      },
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The state a TransitionEvent entered, retained on the event as the append-only source from which currentState is projected."
      },
      {
        "@value": "The state a transition entered. (Q3)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "to state"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#tokensConsumed",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The total tokens this record accounts for, as parsed from the harness's own accounting. One quantity by design: consumption, never remaining quota — the two come from different sources and conflating them cost a closed investigation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "tokens consumed"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#tool",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "For a release-installed Blocker: the executable whose installed version is checked on the evaluating host."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Blocker"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "tool"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#trajectoryOf",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The WorkItem this trajectory is the execution record of. Mandatory in spirit (Q1/Q2 join on it); permissive in the shape until the recording path settles."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "trajectory of"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#transitionVersion",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Selects the canonical transition signing protocol; omission retains legacy v1, while directly enforced processing requires v2 to bind the expected run revision."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#triggerKind",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether a reaction is triggered by event-feed activity or by its schedule."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "triggerKind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#trustTier",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\"human\" marks a VerifierRegistration as a human trust-root key. Human decisions verify only against these, matched as an ASSERTED fact in ROOT. Adding, changing or removing the marker is a registry amendment that an already-enrolled human key must sign. No rdfs:domain on purpose: inference must never type an entity because of it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "trust tier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#ungovernedReason",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Why an executable class traverses no enforcement point. The field that separates an ACKNOWLEDGED bypass surface from an unknown hole — both are ungoverned, and only one of them is a decision somebody made. The inventory check reports the two differently and never as each other."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ungoverned reason"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#unit",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#untrustedOrigin",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Where the imported state comes from, in prose, for a reader deciding how much to worry. Free text rather than an enum: an enum would go stale the first time a new integration lands, and a wrong enum value is worse than a sentence."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#ToolClass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "untrusted origin"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#verificationPoint",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The enforcement point at which this constraint is evaluated: \"PAG\" (Pre-Action Gate, before dispatch), \"ATM\" (Action-Time Monitor, mid-flight), \"PAA\" (Post-Action Auditor, after the action and before the next), \"tool_layer\", or \"policy_layer\". Finer than aegis:boundary, which stays the coarse action/transition split. Which points a constraint may occupy is decided by its class — see src/governance/placement.rs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#Policy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verification point"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#verifiedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Verification a step (or a trajectory's terminal claim) produced. Ranges over aegis:Verification, so the falsifier discipline applies unchanged — an unfalsifiable check never makes a trajectory admissible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verified by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#verified_by",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How bytes read through a mapping are checked: a content hash, cosign signature, or Quipu certification seal identifier."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "external truth verification method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#verifier",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Who rendered the verdict, as a key id. Carried by both Verdict and VerifierRegistration — on the first it is a claim, on the second it is the registration that makes the claim checkable — so no rdfs:domain."
      },
      {
        "@value": "quipu-owned. The agent a VerifierRegistration registers a key for. Reused by workflow-and-archive Q6 and Q7 — the join from a transition's performer to its key."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://github.com/scbrown/quipu"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#verifies",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The claim or change this Verification's check bears on — the 'X is fixed/landed/deployed' whose falsifier it ran. Owed to Q3, which joins a verification's time against the change that followed it. No range constraint: the subject may be a work item, a commit, or a deploy record."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verifies"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#workKind",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "What kind of planned work a tracked WorkItem is: Directive, Design, Plan or DreamCycle. Derived from the tracker record's labels and type; it is why the item carries an aegis:idleLimit. Ordinary work carries none."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/intigraph/quipu/ns#WorkItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "work kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#cacheReadInputTokens",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Input tokens served from cache."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "cacheReadInputTokens"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#cacheWriteInputTokens",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Input tokens written to cache."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "cacheWriteInputTokens"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#inputTokensUncached",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Input tokens excluding cache reads and cache writes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "inputTokensUncached"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#outputTokens",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Output tokens including any reasoning subset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "outputTokens"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#usageHarness",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Harness that wrote the request record."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "usageHarness"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#usageModel",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Per-request model identifier recorded by the harness."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "usageModel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/usage-breakdown/ns#usageModelSource",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Field provenance distinguishing declared model from billed model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "usageModelSource"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#Decision",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A choice made in the course of work: what was chosen, over what visible alternatives, why, by whom, under which work item. Recorded at the moment it happens."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Decision"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#Metric",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A catalogued measurement identity, its meaning, owner, probe, and executable retrieval method. Samples remain in the measurement system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Metric"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#Observation",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An observed violation or decision input. It is deliberately not a time-series sample mirror."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Observation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#Step",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One action in a trajectory: actor, action, target, the Decision it enacts, the Verification it produced (if any), and its order. A step outside a trajectory is meaningless — stepOf is mandatory."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Step"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#TransitionEvent",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One append-only state transition of a run: which step, from what state to what state, when, performed and signed by which agent. The truth of run state; currentState is derived convenience. (Q3, Q6, Q7)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transition event"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#Verification",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A claim that a check established something at a stated time. It is admissible only with the falsifier: the result that would have proved the claim wrong."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Verification"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#VerifierRegistration",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "quipu-owned. The record binding an agent to the public key that verifies its signatures. Lives in a dataKind=identity graph that is never frozen — which is what keeps archived transitions checkable. Reused by workflow-and-archive Q6 and Q7."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://github.com/scbrown/quipu"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Verifier registration"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#WorkItem",
    "http://purl.org/dc/terms/isReplacedBy": [
      {
        "@id": "https://schema.org/Action"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Legacy stored work-item type. New work uses schema:Action and the Seeds-owned profile; this replacement declaration is not a data rewrite or owl:sameAs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Work item"
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "true"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowDefinition",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A named workflow: the steps and transitions runs of it may take. The definition is durable knowledge; its runs are operational, window-graphed data. (Q1, Q5)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Workflow definition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowRun",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One execution of a WorkflowDefinition. Lives in the time-windowed operational graph of the month it started; freezing the window archives the run without unbinding its IRI. (Q1-Q4, Q8)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Workflow run"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#WorkflowStep",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One declared step of a WorkflowDefinition. Distinct from the golden-path trajectory step (aegis:stepOf): this is prescriptive structure, that is an observed walk. (Q5)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Workflow step"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/quipu/ns#verifiedAt",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The observed time this Verification's check was last run. Owed to Q3: a falsifier run once and never re-run after a change is a stale proof wearing a current one's clothes. A fact of the run, never a stored 'still current' verdict."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verified at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  }
]
