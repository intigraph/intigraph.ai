      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#Session",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One harness session of a principal, parsed from the harness's own on-disk record. It is the denominator Q19 needs: a session with no usage record must read UNKNOWN, never zero — which requires the session to be stored independently of its records."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Session"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#SoftwareVersionShape",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb1ca69149219ca1e07d41e813143c7ddc4e4b74668c99f5a8ea14b79cefa049f71"
      },
      {
        "@id": "_:cb1df3ad4933f3531fecd5699a8740c3ed58aaaddc197925f387d268b691262199e"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://schema.org/SoftwareApplication"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#SystemdService",
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/intigraph/camayoc/core/ns#Service"
      }
    ]
  },
  {
    "@id": "https://w3id.org/intigraph/camayoc/core/ns#TVSeriesShape",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb186fb03226b1b2113857ed3152f865106c54a6f7dbb04ad00c54dec59d2643656"
      },
      {
